    <!-- 2.7 Maintenance intervals ======================================= -->
    <changeSet id="1786000002-13" author="machine-specialist-platform">
        <createSequence sequenceName="maintenance_interval_seq" startValue="1" incrementBy="50"/>
        <createTable tableName="maintenance_interval">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="created_by" type="bigint"/>
            <column name="updated_by" type="bigint"/>
            <column name="preventive_maintenance_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="basis" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="meter_id" type="bigint"/>
            <column name="interval_value" type="double precision">
                <constraints nullable="false"/>
            </column>
