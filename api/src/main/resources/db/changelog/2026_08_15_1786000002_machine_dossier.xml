    <!-- 2.10 Polymorphic custom fields ================================== -->
    <changeSet id="1786000002-17" author="machine-specialist-platform">
        <addColumn tableName="custom_field">
            <column name="entity_type" type="varchar(32)"/>
            <column name="entity_id" type="bigint"/>
            <column name="field_group" type="varchar(128)"/>
            <column name="display_order" type="int"/>
            <column name="company_id" type="bigint"/>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="created_by" type="bigint"/>
            <column name="updated_by" type="bigint"/>
        </addColumn>
        <!-- Existing rows were all vendor fields; carry them over verbatim. -->
        <sql splitStatements="false"><![CDATA[
            UPDATE custom_field SET entity_type = 'VENDOR', entity_id = vendor_id
             WHERE entity_id IS NULL AND vendor_id IS NOT NULL;

            UPDATE custom_field cf
               SET company_id = v.company_id
              FROM vendor v
             WHERE cf.vendor_id = v.id AND cf.company_id IS NULL;

            -- Anything left without a company can't be scoped to a tenant and
            -- would break the isolation check on load.
            DELETE FROM custom_field WHERE company_id IS NULL;
        ]]></sql>
        <dropColumn tableName="custom_field" columnName="vendor_id"/>
        <addNotNullConstraint tableName="custom_field" columnName="entity_type" columnDataType="varchar(32)"/>
        <addNotNullConstraint tableName="custom_field" columnName="entity_id" columnDataType="bigint"/>
        <addNotNullConstraint tableName="custom_field" columnName="company_id" columnDataType="bigint"/>
        <addForeignKeyConstraint baseTableName="custom_field" baseColumnNames="company_id"
                                 constraintName="fk_custom_field_company"
                                 referencedTableName="company" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <modifyDataType tableName="custom_field" columnName="value" newDataType="varchar(4000)"/>
        <createIndex tableName="custom_field" indexName="idx_custom_field_entity">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
    </changeSet>

