<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!--
      Phase 1 - the machine dossier.

      Every new column is nullable or defaulted, so existing rows keep working
      and the frontend can migrate at its own pace. One changeSet per section of
      the plan, so each is independently revertible.
    -->

    <!-- 2.1 Equipment breakdown structure ============================== -->
    <changeSet id="1786000002-1" author="machine-specialist-platform">
        <addColumn tableName="asset">
            <column name="level" type="varchar(32)" defaultValue="EQUIPMENT"/>
            <column name="position_code" type="varchar(64)"/>
            <column name="functional_description" type="varchar(255)"/>
            <column name="criticality" type="int"/>
            <column name="downtime_cost_per_hour" type="double precision"/>
            <column name="replacement_cost" type="double precision"/>
            <column name="tracking_class" type="varchar(32)" defaultValue="NON_TRACKED"/>
            <column name="equipment_class" type="varchar(64)"/>
        </addColumn>
        <!-- Backfill: everything that exists today is a machine. -->
        <update tableName="asset">
            <column name="level" value="EQUIPMENT"/>
            <where>level IS NULL</where>
        </update>
        <update tableName="asset">
            <column name="tracking_class" value="NON_TRACKED"/>
            <where>tracking_class IS NULL</where>
        </update>
        <createIndex tableName="asset" indexName="idx_asset_level">
            <column name="level"/>
        </createIndex>
        <createIndex tableName="asset" indexName="idx_asset_equipment_class">
            <column name="equipment_class"/>
        </createIndex>
    </changeSet>

    <!-- 2.5 Part identity and sourcing ================================== -->
    <changeSet id="1786000002-2" author="machine-specialist-platform">
        <addColumn tableName="part">
            <column name="manufacturer" type="varchar(255)"/>
            <column name="mpn" type="varchar(255)"/>
            <column name="preferred_supplier_sku" type="varchar(255)"/>
            <column name="lead_time_days_typical" type="double precision"/>
            <column name="criticality" type="int"/>
            <column name="shelf_life_days" type="int"/>
            <column name="storage_conditions" type="varchar(255)"/>
            <column name="stock_recommended" type="boolean" defaultValueBoolean="false"/>
            <column name="reorder_point" type="double precision"/>
        </addColumn>
        <createIndex tableName="part" indexName="idx_part_mpn">
            <column name="mpn"/>
        </createIndex>
    </changeSet>

    <!-- 2.7 Multi-counter PM triggering ================================= -->
    <changeSet id="1786000002-3" author="machine-specialist-platform">
        <addColumn tableName="preventive_maintenance">
            <column name="trigger_mode" type="varchar(32)" defaultValue="WHICHEVER_FIRST"/>
            <column name="equipment_class" type="varchar(64)"/>
            <column name="template_key" type="varchar(128)"/>
        </addColumn>
    </changeSet>

    <!-- 2.8 Documents (the knowledge layer's anchor) ===================== -->
    <changeSet id="1786000002-4" author="machine-specialist-platform">
        <createSequence sequenceName="document_seq" startValue="1" incrementBy="50"/>
        <createTable tableName="document">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="created_by" type="bigint"/>
            <column name="updated_by" type="bigint"/>
            <column name="file_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="asset_id" type="bigint"/>
            <column name="equipment_class" type="varchar(64)"/>
            <column name="doc_type" type="varchar(32)" defaultValue="OTHER"/>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="manufacturer" type="varchar(255)"/>
            <column name="revision" type="varchar(64)"/>
            <column name="language" type="varchar(8)"/>
            <column name="page_count" type="int"/>
            <column name="ingest_status" type="varchar(32)" defaultValue="PENDING"/>
            <column name="ingested_at" type="timestamp"/>
            <column name="checksum" type="varchar(128)"/>
            <column name="ingest_error" type="varchar(2000)"/>
            <column name="chunk_count" type="int" defaultValueNumeric="0"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="document" baseColumnNames="company_id"
                                 constraintName="fk_document_company"
                                 referencedTableName="company" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="document" baseColumnNames="file_id"
                                 constraintName="fk_document_file"
                                 referencedTableName="file" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="document" baseColumnNames="asset_id"
                                 constraintName="fk_document_asset"
                                 referencedTableName="asset" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <createIndex tableName="document" indexName="idx_document_asset">
            <column name="asset_id"/>
        </createIndex>
        <createIndex tableName="document" indexName="idx_document_class">
            <column name="equipment_class"/>
        </createIndex>
        <createIndex tableName="document" indexName="idx_document_status">
            <column name="ingest_status"/>
        </createIndex>
    </changeSet>

    <!-- 2.2 Typed spec sheet with provenance ============================ -->
    <changeSet id="1786000002-5" author="machine-specialist-platform">
        <createSequence sequenceName="asset_spec_seq" startValue="1" incrementBy="50"/>
        <createTable tableName="asset_spec">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="created_by" type="bigint"/>
            <column name="updated_by" type="bigint"/>
            <column name="asset_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="spec_group" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="spec_key" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="varchar(255)"/>
            <column name="value_text" type="varchar(2000)"/>
            <column name="value_num" type="double precision"/>
            <column name="unit" type="varchar(64)"/>
            <column name="source" type="varchar(32)" defaultValue="MANUAL_ENTRY"/>
            <column name="source_document_id" type="bigint"/>
            <column name="source_page" type="int"/>
            <column name="confidence" type="double precision"/>
            <column name="verified_by_id" type="bigint"/>
            <column name="verified_at" type="timestamp"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="asset_spec" baseColumnNames="company_id"
                                 constraintName="fk_asset_spec_company"
                                 referencedTableName="company" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="asset_spec" baseColumnNames="asset_id"
                                 constraintName="fk_asset_spec_asset"
                                 referencedTableName="asset" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="asset_spec" baseColumnNames="source_document_id"
                                 constraintName="fk_asset_spec_document"
                                 referencedTableName="document" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="asset_spec" baseColumnNames="verified_by_id"
                                 constraintName="fk_asset_spec_verified_by"
                                 referencedTableName="own_user" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <createIndex tableName="asset_spec" indexName="idx_asset_spec_asset">
            <column name="asset_id"/>
        </createIndex>
        <createIndex tableName="asset_spec" indexName="idx_asset_spec_key">
            <column name="spec_key"/>
        </createIndex>
        <addUniqueConstraint tableName="asset_spec" columnNames="asset_id, spec_key"
                             constraintName="uq_asset_spec_asset_key"/>
    </changeSet>

    <changeSet id="1786000002-6" author="machine-specialist-platform">
        <createSequence sequenceName="spec_key_catalog_seq" startValue="1" incrementBy="50"/>
        <createTable tableName="spec_key_catalog">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="created_by" type="bigint"/>
            <column name="updated_by" type="bigint"/>
            <column name="equipment_class" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="spec_group" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="spec_key" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="label_en" type="varchar(255)"/>
            <column name="label_es" type="varchar(255)"/>
            <column name="unit" type="varchar(64)"/>
            <column name="value_type" type="varchar(16)" defaultValue="TEXT"/>
            <column name="required" type="boolean" defaultValueBoolean="false"/>
            <column name="display_order" type="int"/>
            <column name="system_seeded" type="boolean" defaultValueBoolean="false"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="spec_key_catalog" baseColumnNames="company_id"
                                 constraintName="fk_spec_key_catalog_company"
                                 referencedTableName="company" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <createIndex tableName="spec_key_catalog" indexName="idx_spec_key_catalog_class">
            <column name="equipment_class"/>
        </createIndex>
        <addUniqueConstraint tableName="spec_key_catalog"
                             columnNames="company_id, equipment_class, spec_key"
                             constraintName="uq_spec_key_catalog"/>
    </changeSet>

    <!-- 2.3 Serialized components and the back-to-birth ledger ========== -->
    <changeSet id="1786000002-7" author="machine-specialist-platform">
        <createSequence sequenceName="component_instance_seq" startValue="1" incrementBy="50"/>
        <createTable tableName="component_instance">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="created_by" type="bigint"/>
            <column name="updated_by" type="bigint"/>
            <column name="serial_number" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="part_type_id" type="bigint"/>
            <column name="manufacturer" type="varchar(255)"/>
            <column name="mpn" type="varchar(255)"/>
            <column name="manufacture_date" type="timestamp"/>
            <column name="acquired_at" type="timestamp"/>
            <column name="acquisition_cost" type="double precision"/>
            <column name="status" type="varchar(32)" defaultValue="IN_STOCK"/>
            <column name="current_position_id" type="bigint"/>
            <column name="total_hours" type="double precision" defaultValueNumeric="0"/>
            <column name="total_cycles" type="double precision" defaultValueNumeric="0"/>
            <column name="hours_since_overhaul" type="double precision" defaultValueNumeric="0"/>
            <column name="cycles_since_overhaul" type="double precision" defaultValueNumeric="0"/>
            <column name="hour_limit" type="double precision"/>
            <column name="cycle_limit" type="double precision"/>
            <column name="calendar_limit_months" type="int"/>
            <column name="image_id" type="bigint"/>
            <column name="notes" type="varchar(2000)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="component_instance" baseColumnNames="company_id"
                                 constraintName="fk_component_instance_company"
                                 referencedTableName="company" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="component_instance" baseColumnNames="part_type_id"
                                 constraintName="fk_component_instance_part"
                                 referencedTableName="part" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="component_instance" baseColumnNames="current_position_id"
                                 constraintName="fk_component_instance_position"
                                 referencedTableName="asset" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="component_instance" baseColumnNames="image_id"
                                 constraintName="fk_component_instance_image"
                                 referencedTableName="file" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <createIndex tableName="component_instance" indexName="idx_component_instance_position">
            <column name="current_position_id"/>
        </createIndex>
        <createIndex tableName="component_instance" indexName="idx_component_instance_serial">
            <column name="serial_number"/>
        </createIndex>
    </changeSet>

    <changeSet id="1786000002-8" author="machine-specialist-platform">
        <createSequence sequenceName="component_event_seq" startValue="1" incrementBy="50"/>
        <createTable tableName="component_event">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column name="updated_at" type="timestamp"/>
            <column name="created_by" type="bigint"/>
            <column name="updated_by" type="bigint"/>
            <column name="component_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="position_id" type="bigint"/>
            <column name="occurred_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="position_meter_value" type="double precision"/>
