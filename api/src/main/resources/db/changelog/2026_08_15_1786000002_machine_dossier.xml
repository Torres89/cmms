            <column name="component_cycles" type="double precision"/>
            <column name="work_order_id" type="bigint"/>
            <column name="performed_by_id" type="bigint"/>
            <column name="vendor_id" type="bigint"/>
            <column name="cost" type="double precision"/>
            <column name="reason" type="varchar(2000)"/>
            <column name="document_reference" type="varchar(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="component_event" baseColumnNames="company_id"
                                 constraintName="fk_component_event_company"
                                 referencedTableName="company" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="component_event" baseColumnNames="component_id"
                                 constraintName="fk_component_event_component"
                                 referencedTableName="component_instance" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="component_event" baseColumnNames="position_id"
                                 constraintName="fk_component_event_position"
                                 referencedTableName="asset" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="component_event" baseColumnNames="work_order_id"
                                 constraintName="fk_component_event_work_order"
                                 referencedTableName="work_order" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="component_event" baseColumnNames="performed_by_id"
                                 constraintName="fk_component_event_user"
                                 referencedTableName="own_user" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="component_event" baseColumnNames="vendor_id"
                                 constraintName="fk_component_event_vendor"
                                 referencedTableName="vendor" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <createIndex tableName="component_event" indexName="idx_component_event_component">
            <column name="component_id"/>
        </createIndex>
        <createIndex tableName="component_event" indexName="idx_component_event_occurred">
            <column name="occurred_at"/>
        </createIndex>
    </changeSet>

    <!-- Envers revision table for the two compliance-relevant entities. -->
    <changeSet id="1786000002-9" author="machine-specialist-platform">
        <sql splitStatements="false"><![CDATA[
            CREATE TABLE IF NOT EXISTS component_event_aud (
              id                  BIGINT NOT NULL,
              rev                 INTEGER NOT NULL,
              revtype             SMALLINT,
              company_id          BIGINT,
              created_at          TIMESTAMP,
              updated_at          TIMESTAMP,
              created_by          BIGINT,
              updated_by          BIGINT,
              component_id        BIGINT,
              type                VARCHAR(32),
              position_id         BIGINT,
              occurred_at         TIMESTAMP,
              position_meter_value DOUBLE PRECISION,
              component_hours     DOUBLE PRECISION,
              component_cycles    DOUBLE PRECISION,
              work_order_id       BIGINT,
              performed_by_id     BIGINT,
              vendor_id           BIGINT,
              cost                DOUBLE PRECISION,
              reason              VARCHAR(2000),
              document_reference  VARCHAR(255),
              PRIMARY KEY (id, rev)
            );
        ]]></sql>
    </changeSet>

