  "pmTemplates": [
    {
      "title": "Daily operator check",
      "titleEs": "Comprobación diaria del operador",
      "priority": "MEDIUM",
      "triggerMode": "WHICHEVER_FIRST",
      "intervals": [{ "basis": "CALENDAR", "value": 1, "unit": "days" }],
      "tasks": [
        "Coolant level and concentration (refractometer, not by eye)",
        "Way lube reservoir level",
        "Air pressure and drain the water separator",
        "Chip conveyor and pan clear",
        "Visual: leaks, damaged way covers",
        "Listen: abnormal spindle noise"
      ],
      "tasksEs": [
        "Nivel y concentración de refrigerante (refractómetro, no a ojo)",
        "Nivel del depósito de lubricante de guías",
        "Presión de aire y purgar el separador de agua",
        "Transportador y bandeja de virutas despejados",
        "Visual: fugas, cubiertas de guías dañadas",
        "Escuchar: ruido anormal del husillo"
      ]
    },
    {
      "title": "500-hour service",
      "titleEs": "Servicio de 500 horas",
      "priority": "HIGH",
      "triggerMode": "WHICHEVER_FIRST",
      "description": "Manufacturer charts are written as 'every 500 hours or 3 months'. Both counters run; whichever reaches 100% first fires the plan.",
      "intervals": [
        { "basis": "METER", "meter": "Spindle hours", "value": 500, "unit": "h", "warnAtPercent": 90 },
        { "basis": "CALENDAR", "value": 3, "unit": "months", "warnAtPercent": 90 }
      ],
      "tasks": [
        "Verify way lube FLOW at each point, not just reservoir level — checking the reservoir is the standard mistake and it is how spindles die",
        "Clean the coolant tank and replace the coolant filter",
        "Inspect and clean the chip auger",
        "Check drawbar clamping force",
        "Grease the tool changer per the manufacturer's chart",
        "Inspect way wipers for damage and contamination bypass",
        "Check and record backlash on each axis"
      ],
      "tasksEs": [
        "Verificar el FLUJO de lubricante en cada punto, no solo el nivel del depósito",
        "Limpiar el tanque de refrigerante y reemplazar el filtro",
        "Inspeccionar y limpiar el sinfín de virutas",
        "Comprobar la fuerza de amarre de la barra de tiro",
        "Engrasar el cambiador de herramientas según la tabla del fabricante",
        "Inspeccionar los limpiadores de guías",
        "Comprobar y registrar el juego en cada eje"
      ]
    },
    {
      "title": "Annual precision & safety",
      "titleEs": "Precisión y seguridad anual",
      "priority": "HIGH",
      "triggerMode": "WHICHEVER_FIRST",
      "intervals": [{ "basis": "CALENDAR", "value": 12, "unit": "months", "warnAtPercent": 85 }],
      "tasks": [
        "Ballbar test — record the result, it is the trend that matters",
        "Spindle runout and thermal growth",
        "Backlash compensation check and adjustment",
        "Door interlock and E-stop verification",
        "Electrical cabinet clean and filter replacement",
        "Coolant system full drain, clean and recharge",
        "Verify machine level"
      ],
      "tasksEs": [
        "Prueba de barra de bolas — registrar el resultado, lo que importa es la tendencia",
        "Excentricidad del husillo y crecimiento térmico",
        "Comprobación y ajuste de compensación de juego",
        "Verificación de enclavamiento de puertas y parada de emergencia",
        "Limpieza del armario eléctrico y cambio de filtro",
        "Vaciado, limpieza y recarga completa del sistema de refrigerante",
        "Verificar la nivelación de la máquina"
      ]
    }
  ],

  "failureModes": [
    {
      "code": "SPN-BRG-SEIZE", "subunit": "Spindle", "nameEn": "Spindle bearing seizure",
      "nameEs": "Agarrotamiento del rodamiento del husillo",
      "typicalMechanism": "Fatigue spalling / lubrication starvation",
      "typicalCauses": "Lube failure; coolant ingress past the seal; crash overload",
      "detectionMethods": "Vibration RMS; temperature rise; audible change; surface finish degradation",
      "severityDefault": 5
    },
    {
      "code": "SPN-ACC-LOSS", "subunit": "Spindle", "nameEn": "Loss of accuracy / poor surface finish",
      "nameEs": "Pérdida de precisión / mal acabado superficial",
      "typicalMechanism": "Bearing preload loss; thermal growth; runout",
      "typicalCauses": "Bearing wear; crash; thermal cycling without warm-up",
      "detectionMethods": "Test cut; runout indicator; ballbar",
      "severityDefault": 4
    },
    {
      "code": "SPN-DRAW-FORCE", "subunit": "Spindle", "nameEn": "Drawbar clamping force low",
      "nameEs": "Fuerza de amarre baja en la barra de tiro",
      "typicalCauses": "Belleville washer fatigue; contamination; wear",
      "detectionMethods": "Drawbar force gauge; tool pull-out during heavy cuts",
      "severityDefault": 4
    },
    {
      "code": "AX-BS-BACKLASH", "subunit": "Axis", "nameEn": "Ballscrew backlash / wear",
      "nameEs": "Juego / desgaste del husillo de bolas",
      "typicalMechanism": "Ball and raceway wear",
      "typicalCauses": "Inadequate lubrication; contamination past the wipers",
      "detectionMethods": "Indicator reversal test; ballbar; circular interpolation error",
      "severityDefault": 4
    },
    {
      "code": "AX-WAY-WEAR", "subunit": "Axis", "nameEn": "Way / linear guide wear",
      "nameEs": "Desgaste de guías lineales",
      "typicalCauses": "Lube starvation; chip ingress past damaged wipers",
      "detectionMethods": "Straightness check; visible scoring; increased servo load",
      "severityDefault": 4
    },
    {
      "code": "LUBE-NOFLOW", "subunit": "Lubrication", "nameEn": "Way lube not reaching a point",
      "nameEs": "El lubricante no llega a un punto de engrase",
      "typicalMechanism": "Blocked metering unit or crushed line",
      "typicalCauses": "Blocked metering unit; crushed line; pump failure; wrong viscosity oil",
      "detectionMethods": "Verify flow at each point during a lube cycle — reservoir level tells you nothing about whether oil arrived",
      "severityDefault": 5
    },
    {
      "code": "COOL-CONC", "subunit": "Coolant", "nameEn": "Coolant concentration out of spec",
      "nameEs": "Concentración de refrigerante fuera de especificación",
      "typicalCauses": "Water top-up without concentrate; evaporation; tramp oil",
      "detectionMethods": "Refractometer",
      "severityDefault": 2
    },
    {
      "code": "COOL-PUMP-FAIL", "subunit": "Coolant", "nameEn": "Coolant pump failure",
      "nameEs": "Fallo de la bomba de refrigerante",
      "typicalCauses": "Chip ingress; seal wear; running dry",
      "detectionMethods": "No flow at nozzle; pump noise; alarm",
      "severityDefault": 3
    },
    {
      "code": "ATC-MISFEED", "subunit": "Tool changer", "nameEn": "Tool change fault / dropped tool",
      "nameEs": "Fallo de cambio de herramienta / herramienta caída",
      "typicalCauses": "Gripper wear; misalignment; air pressure low; debris in the taper",
      "detectionMethods": "Alarm during change; visual; audible",
      "severityDefault": 3
    },
    {
      "code": "ELEC-DRIVE-FAULT", "subunit": "Electrical", "nameEn": "Servo or drive fault",
      "nameEs": "Fallo de servo o variador",
      "typicalCauses": "Overheating from a clogged cabinet filter; encoder contamination; supply issues",
      "detectionMethods": "Control alarm; cabinet temperature; drive diagnostics",
      "severityDefault": 4
    },
    {
      "code": "CHIP-JAM", "subunit": "Chip conveyor", "nameEn": "Chip conveyor jam",
      "nameEs": "Atasco del transportador de virutas",
      "typicalCauses": "Long stringy chips; overload; worn drive",
      "detectionMethods": "Overload trip; visible backup in the pan",
      "severityDefault": 2
    }
  ],

