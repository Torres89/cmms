  "pmTemplates": [
    {
      "title": "Daily walkaround",
      "titleEs": "Inspección diaria",
      "priority": "MEDIUM",
      "intervals": [{ "basis": "CALENDAR", "value": 1, "unit": "days" }],
      "tasks": [
        "Engine oil and coolant levels",
        "Hydraulic oil level",
        "Drain the fuel water separator",
        "Cooling pack clear of debris — plugging here shows up later as engine and hydraulic faults",
        "Track tension and visible undercarriage damage",
        "Walk the machine for leaks",
        "Check DEF level"
      ],
      "tasksEs": [
        "Niveles de aceite de motor y refrigerante",
        "Nivel de aceite hidráulico",
        "Drenar el separador de agua del combustible",
        "Paquete de refrigeración libre de residuos",
        "Tensión de cadenas y daños visibles en el tren de rodaje",
        "Recorrer la máquina buscando fugas",
        "Comprobar nivel de DEF"
      ]
    },
    {
      "title": "250-hour service",
      "titleEs": "Servicio de 250 horas",
      "priority": "HIGH",
      "triggerMode": "WHICHEVER_FIRST",
      "intervals": [
        { "basis": "METER", "meter": "SMR hours", "value": 250, "unit": "h", "warnAtPercent": 90 },
        { "basis": "CALENDAR", "value": 3, "unit": "months", "warnAtPercent": 90 }
      ],
      "tasks": [
        "Engine oil and filter change",
        "TAKE SOS SAMPLES: engine, hydraulic, transmission, both final drives — trending wear metals is the highest-value predictive practice on this machine and it needs no sensors",
        "Fuel filters",
        "Grease all points per the lubrication chart",
        "Measure and record track sag",
        "Check battery and connections"
      ],
      "tasksEs": [
        "Cambio de aceite y filtro de motor",
        "TOMAR MUESTRAS SOS: motor, hidráulico, transmisión y ambos mandos finales",
        "Filtros de combustible",
        "Engrasar todos los puntos según la tabla",
        "Medir y registrar la flecha de las cadenas",
        "Comprobar batería y conexiones"
      ]
    },
