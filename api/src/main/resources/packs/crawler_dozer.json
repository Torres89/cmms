  "failureModes": [
    {
      "code": "FD-SEAL-LEAK", "subunit": "Powertrain", "nameEn": "Final drive seal leak",
      "nameEs": "Fuga del sello del mando final",
      "typicalMechanism": "Duo-cone seal face wear or debris damage",
      "typicalCauses": "Debris packing; overheating; running low on oil",
      "detectionMethods": "Oil weep at the hub; low oil level at service; SOS iron trending up",
      "severityDefault": 5
    },
    {
      "code": "UC-CHAIN-ELONG", "subunit": "Undercarriage", "nameEn": "Track chain elongation",
      "nameEs": "Elongación de la cadena",
      "typicalMechanism": "Pin and bushing wear",
      "typicalCauses": "Abrasive material; over-tensioning; high-speed reverse operation",
      "detectionMethods": "Pitch measurement over a fixed number of links",
      "severityDefault": 3
    },
    {
      "code": "UC-ROLLER-WEAR", "subunit": "Undercarriage", "nameEn": "Roller / idler wear",
      "nameEs": "Desgaste de rodillos / ruedas guía",
      "typicalCauses": "Abrasive conditions; misalignment; seal failure",
      "detectionMethods": "Wear gauge measurement; visible flange wear; oil weep",
      "severityDefault": 3
    },
    {
      "code": "HYD-CYL-DRIFT", "subunit": "Hydraulics", "nameEn": "Cylinder drift",
      "nameEs": "Deriva del cilindro",
      "typicalMechanism": "Internal seal bypass",
      "typicalCauses": "Piston seal wear; contamination scoring the bore",
      "detectionMethods": "Timed drift test with the blade raised",
      "severityDefault": 3
    },
    {
      "code": "AFT-REGEN-FAULT", "subunit": "Aftertreatment", "nameEn": "DPF regeneration fault",
      "nameEs": "Fallo de regeneración del DPF",
      "typicalCauses": "Excessive idle time; interrupted regens; poor fuel quality",
      "detectionMethods": "Dash lamp; fault code; derate; rising idle-hours ratio",
      "severityDefault": 3
    },
    {
      "code": "COOL-PLUG", "subunit": "Cooling", "nameEn": "Cooling pack plugging",
      "nameEs": "Obstrucción del paquete de refrigeración",
      "typicalCauses": "Dust and chaff; no reversible fan; missed daily check",
      "detectionMethods": "Rising coolant temperature; visible debris; derate",
      "severityDefault": 4
    },
    {
      "code": "ENG-SOS-WEAR", "subunit": "Engine", "nameEn": "Abnormal wear metals in oil sample",
      "nameEs": "Metales de desgaste anormales en la muestra de aceite",
      "typicalMechanism": "Component wear detected before failure",
      "typicalCauses": "Bearing wear; liner scuffing; coolant or fuel dilution",
      "detectionMethods": "SOS trending — Fe, Cu, Cr, Al ppm, viscosity, water and fuel dilution",
      "severityDefault": 4
    }
  ],

