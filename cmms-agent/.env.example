# Atlas CMMS API
CMMS_API_URL=http://localhost:8080
CMMS_FRONT_URL=http://localhost:3000
# Extra browser origins allowed to call the agent (comma separated). CMMS_FRONT_URL
# is always allowed; there is no wildcard.
AGENT_ALLOWED_ORIGINS=

# The agent has NO service account. Callers authenticate with their own Atlas JWT.
# These two are used only by the interactive CLI (agent.py) to sign in; leave them
# unset to be prompted.
CMMS_EMAIL=
CMMS_PASSWORD=

# Postgres — same database as the API. Used for chat sessions, the tool audit
# trail and LLM usage metering.
DB_URL=localhost:5432/atlas
DB_USER=postgres
DB_PWD=
# Or set a full libpq DSN instead of the three above:
# AGENT_DB_DSN=host=localhost port=5432 dbname=atlas user=postgres password=...

# Shared secret the agent uses to read a company's AI provider settings from the
# API's internal endpoint. Must match INTERNAL_SERVICE_TOKEN on the API.
INTERNAL_SERVICE_TOKEN=

# Door 3 (managed AI add-on) / deployment-wide fallback credentials.
# Companies on Door 2 supply their own key in Settings -> AI and never touch these.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL=minimax.minimax-m2
MANAGED_MONTHLY_TOKEN_CAP=3000000

# Door 1 — the remote MCP server. Must be the public HTTPS URL clients reach,
# because ChatGPT accepts remote HTTPS endpoints only.
MCP_ENABLED=true
MCP_PUBLIC_URL=http://localhost:8001
MCP_RATE_LIMIT_PER_MINUTE=120

# Tuning
AGENT_PORT=8001
AGENT_MAX_TOOL_ROUNDS=12
AGENT_HISTORY_TOKEN_BUDGET=12000
AGENT_SESSION_TIMEOUT=1800
LOG_LEVEL=INFO
