# The API, and the shared secret its internal endpoints require.
CMMS_API_URL=http://api:8080
INTERNAL_SERVICE_TOKEN=

# How often to look for sources that are due. Individual sources set their own
# interval on meter_source.poll_interval_minutes.
COLLECTOR_TICK_SECONDS=60
COLLECTOR_DEFAULT_POLL_MINUTES=60

# Meters are cumulative counters, so an unchanged value adds nothing.
COLLECTOR_SKIP_UNCHANGED=true
COLLECTOR_HTTP_TIMEOUT=20

LOG_LEVEL=INFO
