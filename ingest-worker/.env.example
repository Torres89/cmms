# Role: both | server | queue
WORKER_ROLE=both
INGEST_PORT=8002
LOG_LEVEL=INFO

# Postgres — the same database the API uses.
DB_URL=localhost:5432/atlas
DB_USER=postgres
DB_PWD=
# Or a full libpq DSN instead of the three above:
# INGEST_DB_DSN=host=localhost port=5432 dbname=atlas user=postgres password=...

# Object store. Mirrors the API's STORAGE_TYPE: minio | s3 | local
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=atlas-bucket
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_LOCAL_PATH=/data/files

# Embeddings. EMBEDDING_DIMENSIONS must match the VECTOR(n) column in
# document_chunk — changing one without the other breaks every insert.
EMBEDDING_MODEL=google/embeddinggemma-300m
# Required: EmbeddingGemma is a gated repo. Without a token that has accepted
# its licence the download 401s and retrieval falls back to lexical-only.
HF_TOKEN=
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16

# Parsing
ENABLE_OCR=true
OCR_CHARS_PER_PAGE_THRESHOLD=120
MAX_DOCUMENT_MB=300

# Chunking
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=60
CHUNK_MAX_TOKENS=700

# Queue
INGEST_POLL_SECONDS=15
INGEST_MAX_ATTEMPTS=3
INGEST_STALE_LOCK_MINUTES=60

# Extraction. Proposals land unverified in the review queue; nothing extracted
# is ever shown as established fact.
ENABLE_EXTRACTION=true
EXTRACTION_MIN_CONFIDENCE=0.45
