# ---------------------------------------------------------------------------
# Machine-specialist layer
# ---------------------------------------------------------------------------

# Image namespace for the GHCR pulls in docker-compose.prod.yml. Must be
# lowercase (Docker requires it); the deploy workflow exports this itself.
GH_USER_OR_ORG=

# Shared secret for service-to-service calls (the agent reading AI config, the
# telemetry collector posting readings). Must be identical across services.
# Leaving it empty disables /internal/** entirely.
INTERNAL_SERVICE_TOKEN=

# AES-GCM key for customers' stored AI provider keys. Falls back to
# JWT_SECRET_KEY when empty.
SECRET_ENCRYPTION_KEY=

# The ingest worker, used for query embedding and OCR. Empty makes retrieval
# run lexical-only rather than failing outright.
EMBEDDING_URL=http://ingest-worker:8002
# EmbeddingGemma is gated on HuggingFace. Accept the licence at
# https://huggingface.co/google/embeddinggemma-300m, create a token, and set it
# here. Empty means retrieval runs lexical-only.
HF_TOKEN=

# Which half of the ingest worker to run: embed | parse | both.
WORKER_ROLE=both

# Door 1 — the remote MCP server. MCP_PUBLIC_URL must be the public HTTPS URL
# exactly as external clients reach it; OAuth metadata is built from it, so a
# blank value leaves MCP advertising an unreachable endpoint.
MCP_ENABLED=true
MCP_PUBLIC_URL=

# Where the frontend reaches the agent for the in-app chat.
AGENT_URL=

# S3 / Cloudflare R2 storage (STORAGE_TYPE=s3)
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PATH_STYLE=true

# Filesystem storage (STORAGE_TYPE=local) — the self-hosted tier. The signing
# key is required only when STORAGE_TYPE=local; other backends leave the local
# service unconfigured rather than failing to start.
STORAGE_LOCAL_PATH=/data/files
STORAGE_LOCAL_SIGNING_KEY=
STORAGE_INLINE_MAX_BYTES=33554432

# AGPL section 13: where the corresponding source is published. Surfaced in the
# app footer and sidebar.
SOURCE_CODE_URL=

# Telemetry collector (started with the `telemetry` compose profile).
COLLECTOR_TICK_SECONDS=60
COLLECTOR_DEFAULT_POLL_MINUTES=60
